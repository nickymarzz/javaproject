# Database connection URL, including host, port, database name, and connection parameters.
db.url=jdbc:mysql://localhost:3306/game_resources?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Username for connecting to the database.
db.user=root

# Password for the specified database user.
# IMPORTANT: In a production environment, avoid hardcoding passwords directly in property files.
db.password=your_password_here
